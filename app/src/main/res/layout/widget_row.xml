<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/widget_pad"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/widget_row"
        android:orientation="horizontal">


    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:minWidth="@dimen/widget_time_column"
        android:layout_height="wrap_content"
        android:fontFamily="@font/rh_display_black"
        android:textColor="@color/widget_ink"
        android:textSize="@dimen/widget_time" />

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/widget_icon"
        android:layout_height="@dimen/widget_icon"
        android:layout_marginStart="@dimen/widget_gap"
        android:contentDescription="@null"
        android:tint="@color/widget_muted" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_bed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rh_display_black"
            android:textColor="@color/widget_ink"
            android:textSize="@dimen/widget_bed" />

        <TextView
            android:id="@+id/row_what"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rh_text_regular"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_body" />
    </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/row_ack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_pad"
        android:minHeight="@dimen/widget_row"
        android:background="@drawable/widget_action"
        android:fontFamily="@font/rh_display_black"
        android:gravity="center"
        android:paddingStart="@dimen/widget_pad"
        android:paddingEnd="@dimen/widget_pad"
        android:text="@string/widget_done"
        android:textColor="@color/widget_on_action"
        android:textSize="@dimen/widget_body"
        android:visibility="gone" />
</LinearLayout>
