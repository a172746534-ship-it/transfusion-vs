<resources>
    <!-- Compose draws the screens; the window itself stays dark so the first frame never flashes white. -->
    <style name="Theme.TransfusionVS" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ward_first_frame</item>
        <item name="android:navigationBarColor">@color/ward_first_frame</item>
        <item name="android:statusBarColor">@color/ward_first_frame</item>
    </style>

    <style name="Theme.TransfusionVS.Alarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ward_first_frame</item>
    </style>
</resources>
